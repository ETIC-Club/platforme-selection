# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/etic_selection

# --- CORS : URL(s) du frontend, séparées par des virgules ---
CORS_ORIGIN=http://localhost:5173

# --- Authentification ---
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=8h
# dev  : active POST /api/auth/dev-login (utilisateurs simulés, JAMAIS en production)
# google : authentification Google (à brancher, voir src/services/authService.js)
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
